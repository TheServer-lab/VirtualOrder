PEICE math

HARD TEX NAME = "Math Piece"
HARD NUM VERSION = 1

SHIP NAME
SHIP VERSION
SHIP ADD
SHIP SUBTRACT
SHIP MULTIPLY
SHIP SQUARE

JOB ADD NUM A NUM B
    GIVE A + B
ENDJOB

JOB SUBTRACT NUM A NUM B
    GIVE A - B
ENDJOB

JOB MULTIPLY NUM A NUM B
    GIVE A * B
ENDJOB

JOB SQUARE NUM A
    GIVE A * A
ENDJOB

ENDPEICE